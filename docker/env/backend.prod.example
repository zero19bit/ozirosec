APP_NAME=HackPath
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hackpath
DB_USERNAME=hackpath
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_DOMAIN=app.example.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_SUPPORTS_CREDENTIALS=true
SANCTUM_STATEFUL_DOMAINS=app.example.com

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@app.example.com
MAIL_FROM_NAME=HackPath

QUEUE_CONNECTION=database
HACKPATH_ENFORCE_PRODUCTION_CONFIG=true
HACKPATH_FLAG_SECRET=
HACKPATH_ADMIN_BOOTSTRAP_ENABLED=false
HACKPATH_ADMIN_EMAIL=
HACKPATH_ADMIN_USERNAME=
HACKPATH_ADMIN_PASSWORD=
