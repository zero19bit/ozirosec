APP_NAME=HackPath
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_A_REAL_GENERATED_KEY
APP_DEBUG=false
APP_URL=https://hackpath.example.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hackpath
DB_USERNAME=hackpath
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_DOMAIN=hackpath.example.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

FRONTEND_URL=https://hackpath.example.com
CORS_ALLOWED_ORIGINS=https://hackpath.example.com
CORS_SUPPORTS_CREDENTIALS=true
SANCTUM_STATEFUL_DOMAINS=hackpath.example.com

MAIL_MAILER=smtp
MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=security@example.com
MAIL_FROM_NAME=HackPath

QUEUE_CONNECTION=database
HACKPATH_FLAG_SECRET=REPLACE_WITH_SERVER_ONLY_FLAG_SECRET
HACKPATH_ADMIN_BOOTSTRAP_ENABLED=false
HACKPATH_ADMIN_EMAIL=
HACKPATH_ADMIN_USERNAME=
HACKPATH_ADMIN_PASSWORD=
