# -----------------------------------------------------------------------------
# Local development defaults
# -----------------------------------------------------------------------------
APP_NAME=HackPath
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local SQLite: simple development default. Never commit database/database.sqlite.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_FOREIGN_KEYS=true

# Required for reliable all-device logout; the sessions table must include user_id.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5173
# Comma-separated origins only; no paths, no wildcard when credentials are enabled.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_SUPPORTS_CREDENTIALS=true
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost,127.0.0.1,::1
HACKPATH_ADMIN_NAME=
HACKPATH_ADMIN_USERNAME=
HACKPATH_ADMIN_EMAIL=
HACKPATH_ADMIN_PASSWORD=

# Server-side lab flag verification.
# Never commit plaintext flags or real digests. Set these in deployment secrets.
HACKPATH_FLAG_ALGORITHM=sha256
HACKPATH_FLAG_SECRET=
# Example per-lab controls:
# HACKPATH_LAB_SQLI_001_ACTIVE=false
# HACKPATH_LAB_SQLI_001_DIGEST=
# HACKPATH_LAB_SQLI_001_POINTS=10

# -----------------------------------------------------------------------------
# Automated testing recommendations
# -----------------------------------------------------------------------------
# APP_ENV=testing
# APP_DEBUG=true
# DB_CONNECTION=sqlite
# DB_DATABASE=:memory:
# SESSION_DRIVER=array

# -----------------------------------------------------------------------------
# PostgreSQL production example - replace placeholders in your secret manager only
# -----------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=warning
# APP_URL=https://api.example.com
# FRONTEND_URL=https://app.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CORS_SUPPORTS_CREDENTIALS=true
# HACKPATH_ALLOW_LOCAL_CORS_IN_PRODUCTION=false
# SESSION_SECURE_COOKIE=true
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=none
# DB_CONNECTION=pgsql
# DB_HOST=postgres.internal
# DB_PORT=5432
# DB_DATABASE=hackpath
# DB_USERNAME=hackpath_app
# DB_PASSWORD=<database-password-from-secret-manager>
# DB_SSLMODE=require

# -----------------------------------------------------------------------------
# MySQL production example - replace placeholders in your secret manager only
# -----------------------------------------------------------------------------
# APP_ENV=production
# APP_DEBUG=false
# LOG_LEVEL=warning
# APP_URL=https://api.example.com
# FRONTEND_URL=https://app.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CORS_SUPPORTS_CREDENTIALS=true
# HACKPATH_ALLOW_LOCAL_CORS_IN_PRODUCTION=false
# SESSION_SECURE_COOKIE=true
# SESSION_HTTP_ONLY=true
# SESSION_SAME_SITE=none
# DB_CONNECTION=mysql
# DB_HOST=mysql.internal
# DB_PORT=3306
# DB_DATABASE=hackpath
# DB_USERNAME=hackpath_app
# DB_PASSWORD=<database-password-from-secret-manager>
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

